# Copiar a .env y completar con los valores del entorno.
# El archivo .env NO se versiona: contiene el pepper y la API key móvil.

# API URL de Nova Backend (Android usa 10.0.2.2 en lugar de localhost para simulador)
EXPO_PUBLIC_API_URL=http://localhost:9090

# Secretos de Seguridad (Pepper usado para hashear las contraseñas)
# Debe coincidir con SecuritySettings:PasswordSecret (NOVA_PEPPER) del backend.
EXPO_PUBLIC_PASSWORD_SECRET=your-pepper-value

# API Key para endpoints pre-login de Nova Connect (ValidateLogin, Register, GetHelpInfo)
# Debe coincidir con MobileApi:ApiKey (NOVA_MOBILE_API_KEY) del backend.
EXPO_PUBLIC_MOBILE_API_KEY=your-mobile-api-key
